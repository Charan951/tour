{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run seed:*)",
      "Bash(npm --prefix server run:*)",
      "Bash(npm --prefix client run:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./server/.env)",
      "Read(./client/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
