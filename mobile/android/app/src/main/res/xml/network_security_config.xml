<?xml version="1.0" encoding="utf-8"?>
<!--
  Production traffic (tour.speshway.site) is HTTPS-only: cleartext HTTP is
  denied by the base-config below. Local development against a plaintext
  backend still works because the loopback / emulator / private-LAN hosts
  used by the api_service candidate-URL fallback are explicitly allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
    </domain-config>
</network-security-config>
