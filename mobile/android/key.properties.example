# Copy to android/key.properties (git-ignored) and fill in real values to
# produce a Play-Store-signable release build.
#
# 1. Generate an upload keystore (once):
#    keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#            -validity 10000 -alias upload
# 2. Put upload-keystore.jks somewhere OUTSIDE the repo (or it's git-ignored here).
# 3. Fill the values below. storeFile is resolved relative to android/.
#
# Without this file the release build falls back to the debug key (fine for
# `flutter run --release`, NOT acceptable for a store upload).

storePassword=changeme
keyPassword=changeme
keyAlias=upload
storeFile=upload-keystore.jks
